# CodeForge — variables de entorno de ejemplo.
# Copia este archivo a .env y ajusta los valores. NUNCA introduzcas secretos reales aquí.

# ---------- Entorno general ----------
# NODE_ENV NO se define aquí a propósito: lo fija el runtime (vitest pone "test"
# al ejecutar tests, Docker/producción pone "production", si no hay nada se usa
# "development" por defecto). Definirlo en .env pisaría esos valores — por eso
# si haces `source .env` para probar comandos a mano, evita exportar NODE_ENV.
LOG_LEVEL=info

# ---------- PostgreSQL (usado por docker-compose) ----------
POSTGRES_USER=codeforge
POSTGRES_PASSWORD=codeforge_dev_password
POSTGRES_DB=codeforge
POSTGRES_PORT=5432

# Rol de aplicación (lectura/escritura completa vía Prisma)
DATABASE_URL=postgresql://codeforge:codeforge_dev_password@localhost:5432/codeforge?schema=public

# Rol de solo lectura para el SQL Lab (sandbox). Se crea en las migraciones.
# Nunca debe tener permisos de escritura ni acceso fuera del schema `sandbox`.
SANDBOX_DATABASE_URL=postgresql://codeforge_sandbox:codeforge_sandbox_password@localhost:5432/codeforge?schema=sandbox
SANDBOX_DB_USER=codeforge_sandbox
SANDBOX_DB_PASSWORD=codeforge_sandbox_password

# ---------- API principal ----------
API_PORT=4000
API_HOST=0.0.0.0

# Secretos JWT — genera valores aleatorios propios en tu .env local (openssl rand -hex 32)
JWT_ACCESS_SECRET=change_me_dev_only_access_secret
JWT_REFRESH_SECRET=change_me_dev_only_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

CORS_ORIGIN=http://localhost:5173

# AUTH_RATE_LIMIT_MAX generoso pensado para desarrollo/E2E: el modo desarrollo
# de React (StrictMode) invoca efectos dos veces y cada recarga completa de
# página dispara un refresh silencioso, lo que multiplica las peticiones a
# /auth/*. En producción (build de React, sin doble invocación) un valor más
# bajo (p. ej. 50) sigue siendo generoso para uso real y mucho más estricto
# frente a fuerza bruta — ajusta este valor en el entorno de despliegue, no
# aquí. Si no se define esta variable, la API usa 50 por defecto (ver
# apps/api/src/config/env.ts).
# RATE_LIMIT_MAX (general, todo /api) también generoso a propósito: desde la
# Fase 9 cada página autenticada lee /gamification/me y /notifications (racha,
# XP, campana de notificaciones), lo que sube el tráfico de lectura normal de
# una suite E2E completa. Igual que arriba, en producción un valor menor
# sigue siendo cómodo para uso real. Subido de 600 a 1500 en la Fase 11: la
# suite E2E completa (25 specs) genera ~630 peticiones por sí sola, dejando
# el margen de 600 demasiado justo para volver a ejecutarla sin reiniciar la
# API entre medias.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1500
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=300

# ---------- Servicio de ejecución de código (interno, no exponer públicamente) ----------
EXEC_SERVICE_PORT=4100
EXEC_SERVICE_HOST=0.0.0.0
EXEC_SERVICE_URL=http://localhost:4100
# Token compartido entre la API y el exec-service. Genera un valor propio.
EXEC_SERVICE_INTERNAL_TOKEN=change_me_dev_only_internal_token
EXEC_JS_TIMEOUT_MS=2000
EXEC_JS_MEMORY_MB=64
EXEC_SQL_TIMEOUT_MS=2000
EXEC_MAX_OUTPUT_BYTES=65536

# ---------- Frontend (Vite) ----------
VITE_API_URL=http://localhost:4000/api/v1
VITE_APP_NAME=CodeForge

# ---------- Feature flags (valores por defecto, ver FeatureFlag en DB para overrides) ----------
FEATURE_AI_ASSISTANT=false
FEATURE_BETA_COMPANY_MODE=true
FEATURE_CERTIFICATES=false
