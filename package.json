{
  "name": "codeforge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CodeForge — plataforma SaaS educativa para formar desarrolladores/as junior",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "dev:web": "pnpm --filter @codeforge/web dev",
    "dev:api": "pnpm --filter @codeforge/api dev",
    "dev:exec": "pnpm --filter @codeforge/exec-service dev",
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @codeforge/database run generate",
    "db:migrate": "pnpm --filter @codeforge/database run migrate",
    "db:migrate:deploy": "pnpm --filter @codeforge/database run migrate:deploy",
    "db:seed": "pnpm --filter @codeforge/database run seed",
    "db:studio": "pnpm --filter @codeforge/database run studio",
    "postinstall": "pnpm --filter @codeforge/database run generate",
    "prepare": "husky"
  },
  "devDependencies": {
    "@codeforge/database": "workspace:*",
    "@eslint/js": "^9.12.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.0",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.10.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,json,md,css}": [
      "prettier --write"
    ]
  }
}
